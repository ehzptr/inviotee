    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
    <script>
        gsap.registerPlugin(ScrollTrigger, SplitText);
        gsap.config({ force3D: true }); // transform/opacity only, always GPU layers

        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const k = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 1; // 0 = no motion
        const AUTO_SPEED = 90; // px per second for the auto-scroll button
        const RSVP_ENDPOINT = ""; // POST JSON {name, phone, attendance, message}; empty = demo mode, comments stay on this page
        history.scrollRestoration = "manual";
        scrollTo(0, 0);

        /* guest from ?to=Nama&group=VIP */
        const qs = new URLSearchParams(location.search);
        const guest = qs.get("to") || "Nama Tamu";
        $$("[data-guest]").forEach(e => e.textContent = guest);
        $$("[data-group]").forEach(e => e.textContent = qs.get("group") || "VIP");

        /* sections + hidden start state */
        const secs = $$(".sec"), shield = $("#mapShield");
        let cur = 0, opened = false;
        const smooth = () => ({ behavior: k ? "smooth" : "auto" });
        const hide = { autoAlpha: 0, scale: (i, t) => t.dataset.in === "zoom" ? .85 : 1 };
        const reveal = { autoAlpha: 1, y: 0, scale: 1, duration: 1.1 * k, ease: "expo.out", stagger: .1 * k, overwrite: true };
        gsap.set($$("[data-in]"), hide);
        gsap.set("#tools", { yPercent: -130 });
        gsap.set("#actions", { y: 90 });
        gsap.set("[data-f]", { transformOrigin: (i, t) => ({ tl: "0% 0%", tr: "100% 0%", bl: "0% 100%", br: "100% 100%" })[t.dataset.f] });

        const mapFrame = $("iframe[data-src]");
        const loadMap = () => { if (mapFrame.dataset.src) { mapFrame.src = mapFrame.dataset.src; mapFrame.removeAttribute("data-src"); } };
        /* corner frames part outward and settle back on every section change */
        const OUT = { tl: [-1, -1], tr: [1, -1], bl: [-1, 1], br: [1, 1] };
        let kickTl;
        function kick() {
            if (!k) return;
            kickTl?.kill();
            kickTl = gsap.timeline()
                .to("[data-f]", { x: (i, t) => OUT[t.dataset.f][0] * 16, y: (i, t) => OUT[t.dataset.f][1] * 16, scale: 1.05, duration: .35, ease: "power2.out", overwrite: "auto" })
                .to("[data-f]", { x: 0, y: 0, scale: 1, duration: 1.1, ease: "expo.out" });
        }
        function setCur(n) {
            if (n === cur) return;
            cur = n;
            kick();
        }

        /* auto-scroll: a ticker nudges the page; any user input stops it */
        let autoOn = false, pos = 0;
        const btnAuto = $("#btnAuto");
        const setAutoIcon = on => {
            btnAuto.firstElementChild.className = "ph-fill text-xl " + (on ? "ph-pause-circle" : "ph-play-circle");
            btnAuto.setAttribute("aria-pressed", on);
        };
        const autoTick = (t, dt) => {
            pos += AUTO_SPEED * dt / 1000;
            scrollTo(0, pos);
            if (pos >= ScrollTrigger.maxScroll(window)) stopAuto();
        };
        function startAuto() { autoOn = true; pos = scrollY; gsap.ticker.add(autoTick); setAutoIcon(true); }
        function stopAuto() { if (!autoOn) return; autoOn = false; gsap.ticker.remove(autoTick); setAutoIcon(false); }
        btnAuto.addEventListener("click", () => autoOn ? stopAuto() : (opened ? startAuto() : openInvitation()));
        $("#page").addEventListener("touchstart", stopAuto, { passive: true });
        addEventListener("wheel", stopAuto, { passive: true });
        addEventListener("keydown", stopAuto);


        /* every ScrollTrigger is built here, top to bottom, after images and fonts settle (called once by the loader) */
        function init() {
            // 1. headline letters: cover plays on intro, the rest play when scrolled into view
            $$(".sec h2, .sec h1 span").forEach(h => {
                const sp = SplitText.create(h, { type: "words,chars", charsClass: "ch" });
                const from = { autoAlpha: 0, yPercent: 70 };
                if (h.closest("#cover")) return gsap.set(sp.chars, from);
                gsap.fromTo(sp.chars, from, {
                    autoAlpha: 1, yPercent: 0, duration: .9 * k, ease: "expo.out", stagger: .035 * k,
                    scrollTrigger: { trigger: h, start: "top 88%", toggleActions: "play none none reset" }
                });
            });
            // 2. everything else rises in as it enters; resets when scrolled back above so it replays
            ScrollTrigger.batch($$(".sec:not(#cover) [data-in]"), {
                start: "top 88%",
                onEnter: b => gsap.to(b, reveal),
                onLeaveBack: b => gsap.set(b, hide),
            });
            // 3. our story: each milestone brightens as you scroll past it
            $$("li", secs[6]).forEach(li => gsap.fromTo(li, { autoAlpha: .15, x: -18 }, {
                autoAlpha: 1, x: 0, ease: "none",
                scrollTrigger: { trigger: li, start: "top 90%", end: "top 60%", scrub: true }
            }));
            // 4. progress bar + frames drift with the whole page
            const whole = { trigger: "#page", start: "top top", end: "bottom bottom" };
            gsap.fromTo("#tools b", { scaleX: 0 }, { scaleX: 1, ease: "none", scrollTrigger: { ...whole, scrub: .3 } });
            gsap.to("#frames", { scale: 1.05, ease: "none", scrollTrigger: { ...whole, scrub: 1 } });
            // 5. active section triggers the frame burst
            secs.forEach((el, i) => ScrollTrigger.create({ trigger: el, start: "top 50%", end: "bottom 50%", onToggle: self => self.isActive && setCur(i) }));
            // 6. map: load one screen early; shield it again once scrolled away so it never traps the page scroll
            ScrollTrigger.create({ trigger: secs[4], start: "top bottom+=100%", once: true, onEnter: loadMap });
            ScrollTrigger.create({ trigger: secs[4], start: "top bottom", end: "bottom top", onLeave: () => shield.hidden = false, onLeaveBack: () => shield.hidden = false });
            document.fonts?.ready.then(() => ScrollTrigger.refresh());
        }

        /* music */
        const music = $("#music"), btnMusic = $("#btnMusic");
        let userMuted = false;
        const setMusicIcon = on => {
            btnMusic.firstElementChild.className = "ph-fill text-xl " + (on ? "ph-speaker-high" : "ph-speaker-slash");
            btnMusic.setAttribute("aria-pressed", on);
        };
        function playMusic() {
            music.volume = 0;
            music.play().then(() => { gsap.to(music, { volume: 1, duration: 1.5, overwrite: true }); setMusicIcon(true); }).catch(() => setMusicIcon(false));
        }
        btnMusic.addEventListener("click", () => {
            userMuted = !music.paused;
            if (userMuted) { music.pause(); setMusicIcon(false); } else playMusic();
        });
        document.addEventListener("visibilitychange", () => {
            if (document.hidden) { music.pause(); stopAuto(); }
            else if (opened && !userMuted) playMusic();
        });

        /* open invitation: unlock scroll, bring in the progress bar, glide to the first section */
        function openInvitation() {
            if (opened) return;
            opened = true;
            $("#btnOpen").hidden = true;
            playMusic();
            document.documentElement.classList.add("open");
            ScrollTrigger.refresh();
            $("#tools").inert = $("#actions").inert = false;
            gsap.timeline({ defaults: { duration: .8 * k, ease: "power3.out", overwrite: "auto" } })
                .to("#tools", { yPercent: 0 })
                .to("#actions", { y: 0 }, "<");
            secs[1].scrollIntoView(smooth());
        }
        $("#btnOpen").addEventListener("click", openInvitation);

        /* cover entrance: the one authored moment on load */
        const intro = () => {
            gsap.from('[data-f="tl"]', { x: -60, y: -60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="tr"]', { x: 60, y: -60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="bl"]', { x: -60, y: 60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="br"]', { x: 60, y: 60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.fromTo($$("#cover [data-in]"), hide, reveal);
            gsap.to($$("#cover .ch"), { autoAlpha: 1, yPercent: 0, duration: .9 * k, ease: "expo.out", stagger: .035 * k, delay: .25 * k });
        };

        /* loader */
        let ready = false;
        const hideLoader = () => {
            if (ready) return;
            ready = true;
            init();
            gsap.to("#loader", { autoAlpha: 0, duration: .4 * k, onComplete: intro });
        };
        addEventListener("load", () => setTimeout(hideLoader, 100));
        setTimeout(hideLoader, 5000);

        /* dialogs: native <dialog>, stop auto-scroll while open, backdrop click closes */
        function openDlg(d) {
            stopAuto();
            d.showModal();
            gsap.fromTo(d, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .35 * k, ease: "power3.out" });
        }
        $$("dialog").forEach(d => d.addEventListener("click", e => { if (e.target === d) d.close(); }));
        $("#btnQr").addEventListener("click", () => openDlg($("#dlgQr")));
        addEventListener("keydown", e => {
            if (!$("#dlgLb").open) return;
            if (e.key === "ArrowLeft") showShot(lb - 1);
            if (e.key === "ArrowRight") showShot(lb + 1);
        });

        /* lightbox */
        const shots = $$("[data-lb] img");
        let lb = 0;
        const showShot = i => { lb = gsap.utils.wrap(0, shots.length, i); $("#lbImg").src = shots[lb].src; $("#lbImg").alt = shots[lb].alt; };
        $$("[data-lb]").forEach((b, i) => b.addEventListener("click", () => { showShot(i); openDlg($("#dlgLb")); }));
        $("#lbPrev").addEventListener("click", () => showShot(lb - 1));
        $("#lbNext").addEventListener("click", () => showShot(lb + 1));

        /* tabs: gift (transfer / kado) and rsvp (konfirmasi / ucapan) share one helper */
        function tabset(tabSel, panelSel) {
            const tabs = $$(tabSel), panels = $$(panelSel);
            const show = (i, anim) => {
                tabs.forEach((t, j) => t.setAttribute("aria-selected", j === i));
                panels.forEach((p, j) => p.hidden = j !== i);
                if (anim) gsap.from(panels[i], { autoAlpha: 0, y: 8, duration: .4 * k, ease: "expo.out" });
            };
            tabs.forEach((b, i) => b.addEventListener("click", () => { stopAuto(); show(i, true); }));
            show(0);
            return show;
        }
        tabset("[data-gift]", "[data-gift-panel]");
        const showRsvpTab = tabset("[data-rt]", "[data-rp]");

        $("#rsvpForm").addEventListener("focusin", stopAuto); // typing must not get auto-advanced away

        /* copy */
        document.addEventListener("click", async e => {
            const b = e.target.closest("[data-copy]");
            if (!b) return;
            try { await navigator.clipboard.writeText(b.dataset.copy); } catch { return; }
            const t = b.textContent;
            b.textContent = "Disalin";
            setTimeout(() => b.textContent = t, 2000);
        });

        /* countdown */
        const cd = $("#countdown"), nums = $$(".tabular-nums", cd), done = $("#cdDone"), target = new Date(cd.dataset.datetime).getTime();
        function tick() {
            const ms = target - Date.now();
            cd.hidden = ms <= 0;
            done.hidden = ms > 0;
            const s = Math.max(0, Math.floor(ms / 1000));
            [Math.floor(s / 86400), Math.floor(s % 86400 / 3600), Math.floor(s % 3600 / 60), s % 60].forEach((v, i) => nums[i].textContent = v);
        }
        tick();
        setInterval(tick, 1000);

        /* rsvp */
        const form = $("#rsvpForm"), status = $("#rsvpStatus"), send = $("#rsvpSend");
        function addComment({ attendance, message }) {
            const n = $("#tplComment").content.cloneNode(true);
            n.querySelector("[data-i]").textContent = guest.trim()[0]?.toUpperCase() || "?";
            n.querySelector("[data-n]").textContent = guest;
            n.querySelector("[data-a]").textContent = attendance;
            n.querySelector("[data-m]").textContent = message;
            n.querySelector("[data-t]").textContent = new Date().toLocaleString("id-ID", { dateStyle: "long", timeStyle: "short" });
            $("#noComments").hidden = true;
            $("#comments").prepend(n);
            $("#cCount").textContent = $$("#comments article").length;
        }
        form.addEventListener("submit", async e => {
            e.preventDefault();
            const body = {
                name: guest,
                phone: $("#rCode").value + $("#rPhone").value.replace(/^0/, ""),
                attendance: new FormData(form).get("att"),
                message: $("#rMsg").value.trim(),
            };
            send.disabled = true; send.textContent = "Mengirim…"; status.textContent = "";
            try {
                if (RSVP_ENDPOINT) {
                    const r = await fetch(RSVP_ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
                    if (!r.ok) throw new Error(r.status);
                }
                addComment(body);
                status.textContent = RSVP_ENDPOINT ? "Terima kasih, konfirmasi Anda sudah kami terima." : "Mode contoh: ucapan hanya tampil di halaman ini.";
                form.reset();
                showRsvpTab(1, true);
            } catch {
                status.textContent = "Gagal mengirim. Periksa koneksi lalu coba lagi.";
            } finally {
                send.disabled = false; send.textContent = "Kirim";
            }
        });
    </script>
</body>

</html>
