    <!-- lightbox -->
    <dialog id="dlgLb" class="m-0 size-full max-h-none max-w-none bg-black/85 p-0">
        <img id="lbImg" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" class="size-full object-contain">
        <form method="dialog"><button aria-label="Tutup"
                class="fixed right-4 top-4 grid size-12 place-items-center rounded-full bg-white/25 text-white transition hover:bg-white/40"><i
                    class="ph-fill ph-x text-2xl"></i></button></form>
        <button id="lbPrev" aria-label="Sebelumnya"
            class="fixed left-4 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/25 text-white transition hover:bg-white/40"><i
                class="ph-fill ph-caret-left text-2xl"></i></button>
        <button id="lbNext" aria-label="Berikutnya"
            class="fixed right-4 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/25 text-white transition hover:bg-white/40"><i
                class="ph-fill ph-caret-right text-2xl"></i></button>
