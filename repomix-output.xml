    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
    <script>
        gsap.registerPlugin(SplitText);
        gsap.config({ force3D: true }); // transform/opacity only, always GPU layers

        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const k = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 1; // 0 = no motion

        {{> guest.js}}

        /* ---------- world model ----------
           10 stations on a snake path (3 per row). Camera = {x, y} world point at screen centre + zoom s.
           Every layer sees the same camera at a different depth d: screen = (p - c*d) * s_d + centre, s_d = 1 + (s-1)*d.
           d=1 is the world, smaller d = farther away = moves less (parallax). */
        const stage = $("#stage"), panels = $$(".panel"), pcs = $$(".pc"), bars = $$("#prog b"), ovs = $$(".ov"),
            shield = $("#mapShield"), route = $("#route"), world = $("#world"), bg = $("#bg"), frames = $("#frames");
        const idx = id => pcs.findIndex(e => e.dataset.id === id), N = panels.length, VW = 414, COLS = 3, GAP = 220, S_MID = .42;
        const DUR = pcs.map(e => +e.dataset.dur); // autoplay seconds per station (data-dur), counted after the camera arrives
        const layers = [{ el: $("#far"), d: .25 }, { el: $("#mid"), d: .55 }, { el: world, d: 1 }];
        const cam = { x: 0, y: 0, s: 1 };
        let VH = 736, sc = 1, pos = [], total = { w: 0, h: 0 }, Sov = .2, segs = [];
        let cur = 0, mode = "focus", opened = false, locked = false, fl = null, autoOn = false, autoTw, lastZ = -1;

        pcs.forEach((p, i) => $(".ov p", panels[i]).textContent = p.getAttribute("aria-label"));
        /* headline letters rise on arrival; split only after the real fonts load, or SplitText measures fallback glyphs and the splits drift when the webfont swaps in */
        document.fonts.ready.then(() => SplitText.create(".pc h2, .pc h1 span", { type: "words,chars", charsClass: "ch" }));
        const hide = { autoAlpha: 0, scale: (i, t) => t.dataset.in === "zoom" ? .85 : 1 };
        const reveal = { autoAlpha: 1, scale: 1, duration: .9 * k, ease: "expo.out", stagger: .08 * k, overwrite: true };
        gsap.set($$("[data-in]"), hide);
        gsap.set($$(".ch"), { autoAlpha: 0 });
        gsap.set(pcs, { autoAlpha: 0 });
        gsap.set(pcs[0], { autoAlpha: 1 });
        gsap.set(layers.map(l => l.el), { transformOrigin: "0 0" });
        gsap.set("#prog", { autoAlpha: 0 });
        gsap.set("#actions", { y: 90 });
        gsap.set("[data-f]", { transformOrigin: (i, t) => ({ tl: "0% 0%", tr: "100% 0%", bl: "0% 100%", br: "100% 100%" })[t.dataset.f] });

        const ctr = i => ({ x: pos[i].x + VW / 2, y: pos[i].y + VH / 2 });
        const ovCtr = () => ({ x: total.w / 2, y: total.h / 2 });

        function fit() {
            sc = Math.min(innerWidth / VW, innerHeight / 736);
            VH = innerHeight / sc;
            gsap.set(stage, { scale: sc, height: VH, transformOrigin: "50% 0" });
            stage.style.setProperty("--H", VH + "px");
        }

        /* decorative motifs for the two depth layers: kawung (Javanese) + coin (Chinese) */
        const MOTIF = {
            kawung: '<g fill="none" stroke="currentColor" stroke-width="3"><ellipse cx="60" cy="30" rx="17" ry="27"/><ellipse cx="60" cy="90" rx="17" ry="27"/><ellipse cx="30" cy="60" rx="27" ry="17"/><ellipse cx="90" cy="60" rx="27" ry="17"/></g><circle cx="60" cy="60" r="5" fill="currentColor"/>',
            coin: '<g fill="none" stroke="currentColor" stroke-width="3"><circle cx="60" cy="60" r="50"/><rect x="44" y="44" width="32" height="32"/></g>',
        };
        function buildMotifs() {
            [[layers[0], 380, 560, .16], [layers[1], 150, 260, .3]].forEach(([L, min, max, op], li) => {
                let seed = 11 + li * 97;
                const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
                const x0 = (VW / 2) * L.d - 420, x1 = (total.w - VW / 2) * L.d + 420;
                const y0 = (VH / 2) * L.d - VH, y1 = (total.h - VH / 2) * L.d + VH;
                const cell = max * 2.2, nx = Math.max(2, Math.round((x1 - x0) / cell)), ny = Math.max(2, Math.round((y1 - y0) / cell));
                let html = "", n = 0;
                for (let r = 0; r < ny; r++) for (let c = 0; c < nx; c++, n++) {
                    const size = Math.round(min + rnd() * (max - min));
                    const x = Math.round(x0 + (c + rnd() * .7) * (x1 - x0) / nx), y = Math.round(y0 + (r + rnd() * .7) * (y1 - y0) / ny);
                    const col = n % 4 === 3 ? "#9A2B1E" : "#D1A046", kind = rnd() > .5 ? "kawung" : "coin";
                    html += `<svg viewBox="0 0 120 120" width="${size}" height="${size}" style="position:absolute;left:${x}px;top:${y}px;color:${col};opacity:${op}">${MOTIF[kind]}</svg>`;
                }
                L.el.innerHTML = html;
            });
        }
        /* dotted trail between stations (gold once visited) */
        function drawRoute() {
            route.innerHTML = panels.slice(1).map((_, i) => {
                const a = ctr(i), b = ctr(i + 1), mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
                const dx = b.x - a.x, dy = b.y - a.y, L = Math.hypot(dx, dy) || 1, bend = (i % 2 ? 1 : -1) * L * .22;
                return `<path data-seg d="M${a.x} ${a.y}Q${mx - dy / L * bend} ${my + dx / L * bend} ${b.x} ${b.y}"/>`;
            }).join("");
            segs = $$("[data-seg]", route);
            gsap.set(segs, { autoAlpha: i => i < cur ? 1 : .45 });
        }
        function layout() {
            const rows = Math.ceil(N / COLS);
            pos = panels.map((p, i) => { const r = Math.floor(i / COLS), c = i % COLS; return { x: (r % 2 ? COLS - 1 - c : c) * (VW + GAP), y: r * (VH + GAP) }; });
            panels.forEach((p, i) => gsap.set(p, { x: pos[i].x, y: pos[i].y }));
            total = { w: COLS * VW + (COLS - 1) * GAP, h: rows * VH + (rows - 1) * GAP };
            Sov = Math.min(VW * .92 / total.w, VH * .92 / total.h);
            drawRoute();
            buildMotifs();
        }

        /* one function paints the camera onto every layer */
        function render() {
            for (const L of layers) {
                const sd = 1 + (cam.s - 1) * L.d;
                gsap.set(L.el, { x: VW / 2 - cam.x * L.d * sd, y: VH / 2 - cam.y * L.d * sd, scale: sd });
            }
            gsap.set(bg, { x: gsap.utils.clamp(-30, 30, -cam.x * .02), y: gsap.utils.clamp(-50, 50, -cam.y * .02), scale: 1 + (cam.s - 1) * .06 });
            gsap.set(frames, { scale: 1 + (1 - cam.s) * .1 }); // corner frames spread as the camera pulls back
            const z = gsap.utils.clamp(0, 1, (.8 - cam.s) / .35); // station cards + trail only appear when zoomed out
            if (z !== lastZ) { lastZ = z; gsap.set(ovs, { autoAlpha: z }); gsap.set(route, { autoAlpha: z }); }
        }
        function place() {
            const c = mode === "focus" ? ctr(cur) : ovCtr();
            cam.x = c.x; cam.y = c.y; cam.s = mode === "focus" ? 1 : Sov;
            render();
        }
        function relayout() { fl?.kill(); fit(); layout(); place(); }
        addEventListener("resize", relayout);

        /* ---------- state ---------- */
        const OUT = { tl: [-1, -1], tr: [1, -1], bl: [-1, 1], br: [1, 1] };
        let kickTl;
        function kick() { // corner frames part outward and settle back on every move
            if (!k) return;
            kickTl?.kill();
            kickTl = gsap.timeline()
                .to("[data-f]", { x: (i, t) => OUT[t.dataset.f][0] * 16, y: (i, t) => OUT[t.dataset.f][1] * 16, scale: 1.05, duration: .35, ease: "power2.out", overwrite: "auto" })
                .to("[data-f]", { x: 0, y: 0, scale: 1, duration: 1.1, ease: "expo.out" });
        }
        function mark(n) {
            panels.forEach((p, i) => p.toggleAttribute("data-cur", i === n));
            pcs.forEach((p, i) => p.inert = !(mode === "focus" && i === n));
            gsap.to(segs, { autoAlpha: i => i < n ? 1 : .45, duration: .4 * k, overwrite: true });
        }
        function paintBars(n) {
            bars.forEach((b, i) => gsap.set(b, { scaleX: i < n ? 1 : 0 }));
            if (!autoOn) gsap.to(bars[n], { scaleX: 1, duration: .4 * k });
        }
        const mapFrame = $("iframe[data-src]");
        const loadMap = () => { if (mapFrame.dataset.src) { mapFrame.src = mapFrame.dataset.src; mapFrame.removeAttribute("data-src"); } };
        function enter(pc) {
            gsap.fromTo($$("[data-in]", pc), hide, reveal);
            const ch = $$(".ch", pc);
            if (ch.length) gsap.fromTo(ch, { autoAlpha: 0, yPercent: 70 }, { autoAlpha: 1, yPercent: 0, duration: .9 * k, ease: "expo.out", stagger: .035 * k, delay: .1 * k, overwrite: true });
        }
        function showPc(n) { // the station's content appears only once the camera is nearly there
            if (cur !== n || mode !== "focus") return;
            gsap.set(pcs[n], { autoAlpha: 1 });
            enter(pcs[n]);
        }

        /* the signature move: pull back, glide across, push in */
        function go(n, pause = true) {
            n = gsap.utils.clamp(0, N - 1, n);
            if (pause) stopAuto();
            if (n === cur && mode === "focus" && !fl?.isActive()) return;
            fl?.kill(); autoTw?.kill();
            cur = n; mode = "focus";
            $("#btnAll").setAttribute("aria-pressed", "false");
            mark(n); paintBars(n); kick();
            shield.hidden = false; // map ignores swipes again after leaving its station
            if (n >= idx("event")) loadMap();
            gsap.to(pcs, { autoAlpha: 0, duration: .25 * k, overwrite: true });
            const P = ctr(n);
            fl = gsap.timeline({ onUpdate: render, onComplete: () => { render(); if (autoOn) runAuto(); } });
            if (cam.s > .9) {
                fl.to(cam, { s: S_MID, duration: .6 * k, ease: "power2.inOut" })
                    .to(cam, { x: P.x, y: P.y, duration: .9 * k, ease: "power3.inOut" }, "<.15")
                    .add("in", ">-.25")
                    .to(cam, { s: 1, duration: .75 * k, ease: "power3.inOut" }, "in")
                    .add(() => showPc(n), "in+=.3");
            } else { // coming from the overview: one smooth dive
                fl.to(cam, { x: P.x, y: P.y, s: 1, duration: 1.2 * k, ease: "power3.inOut" })
                    .add(() => showPc(n), "-=.35");
            }
        }
        function overview() {
            stopAuto(); fl?.kill();
            mode = "overview";
            $("#btnAll").setAttribute("aria-pressed", "true");
            gsap.to(pcs, { autoAlpha: 0, duration: .25 * k, overwrite: true });
            mark(cur); kick();
            const c = ovCtr();
            fl = gsap.timeline({ onUpdate: render, onComplete: render })
                .to(cam, { x: c.x, y: c.y, s: Sov, duration: 1.3 * k, ease: "power3.inOut" });
        }
        $("#btnAll").addEventListener("click", () => opened && (mode === "focus" ? overview() : go(cur)));
        $("#btnLoc").addEventListener("click", () => go(idx("map"))); // quick way to the map station
        shield.addEventListener("click", () => shield.hidden = true);

        /* ---------- autoplay: one progress tween per station, started after the camera arrives ---------- */
        function runAuto() {
            autoTw?.kill();
            gsap.set(bars[cur], { scaleX: 0 });
            autoTw = gsap.to(bars[cur], { scaleX: 1, duration: DUR[cur], ease: "none", onComplete: () => go(gsap.utils.wrap(0, N, cur + 1), false) });
        }
        const btnAuto = $("#btnAuto");
        const setAutoIcon = on => {
            btnAuto.firstElementChild.className = "ph-fill text-xl " + (on ? "ph-pause-circle" : "ph-play-circle");
            btnAuto.setAttribute("aria-pressed", on);
        };
        function startAuto() {
            autoOn = true; setAutoIcon(true);
            if (mode === "overview") return go(cur, false);
            if (!fl?.isActive()) runAuto();
        }
        function stopAuto() { autoOn = false; autoTw?.kill(); if (bars[cur]) gsap.set(bars[cur], { scaleX: 1 }); setAutoIcon(false); }
        btnAuto.addEventListener("click", () => autoOn ? stopAuto() : (opened ? startAuto() : openInvitation()));

        /* ---------- input: native pointer + wheel + keys. swipe/scroll/arrow = next/prev; in the overview a tap picks a station ---------- */
        const canSwipe = () => opened && mode === "focus" && !document.querySelector("dialog[open]");
        const dist = () => 50 * sc; // 50 design px, in screen px
        const swipe = d => {
            if (locked) return;
            locked = true;
            gsap.delayedCall(.6, () => locked = false);
            go(d > 0 ? gsap.utils.wrap(0, N, cur + 1) : cur - 1); // next wraps to start, prev stops at 0
        };
        let p0 = null;
        stage.addEventListener("pointerdown", e => { p0 = { x: e.clientX, y: e.clientY }; });
        stage.addEventListener("pointerup", e => {
            if (!p0) return;
            const dx = p0.x - e.clientX, dy = p0.y - e.clientY;
            p0 = null;
            const big = Math.max(Math.abs(dx), Math.abs(dy));
            if (opened && mode === "overview") {
                const i = e.target.closest?.("[data-i]")?.dataset.i;
                if (big < 10 && i != null) go(+i);
                return;
            }
            if (canSwipe() && big > dist()) swipe(Math.abs(dy) >= Math.abs(dx) ? dy : dx);
        });
        stage.addEventListener("pointercancel", () => p0 = null);
        stage.addEventListener("wheel", e => { if (canSwipe() && Math.abs(e.deltaY) > 20) swipe(e.deltaY); }, { passive: true });
        addEventListener("keydown", e => {
            if ($("#dlgLb").open) {
                if (e.key === "ArrowLeft") showShot(lb - 1);
                if (e.key === "ArrowRight") showShot(lb + 1);
                return;
            }
            if (!canSwipe() || e.target.matches?.("input,textarea,select")) return;
            if (e.key === "ArrowDown" || e.key === "ArrowRight") swipe(1);
            if (e.key === "ArrowUp" || e.key === "ArrowLeft") swipe(-1);
        });

        {{> music.js}}

        /* open invitation */
        function openInvitation() {
            if (opened) return;
            opened = true;
            $("#btnOpen").hidden = true;
            playMusic();
            $("#actions").inert = false;
            gsap.timeline({ defaults: { duration: .8 * k, ease: "power3.out", overwrite: "auto" } })
                .to("#actions", { y: 0 })
                .to("#prog", { autoAlpha: 1 }, "<");
            startAuto();
            go(1, false);
        }
        $("#btnOpen").addEventListener("click", openInvitation);

        /* cover entrance: the one authored moment on load */
        const intro = () => {
            gsap.from('[data-f="tl"]', { x: -60, y: -60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="tr"]', { x: 60, y: -60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="bl"]', { x: -60, y: 60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="br"]', { x: 60, y: 60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            enter(pcs[0]);
        };
        let ready = false;
        const hideLoader = () => {
            if (ready) return;
            ready = true;
            gsap.to("#loader", { autoAlpha: 0, duration: .4 * k, onComplete: intro });
        };
        addEventListener("load", () => setTimeout(hideLoader, 100));
        setTimeout(hideLoader, 5000);

        /* dialogs: native <dialog>, pause autoplay while open, backdrop click closes */
        let resumeAuto = false;
        function openDlg(d) {
            resumeAuto = autoOn;
            stopAuto();
            d.showModal();
            gsap.fromTo(d, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .35 * k, ease: "power3.out" });
        }
        $$("dialog").forEach(d => {
            d.addEventListener("close", () => { if (resumeAuto) startAuto(); resumeAuto = false; });
            d.addEventListener("click", e => { if (e.target === d) d.close(); });
        });
        $("#btnQr").addEventListener("click", () => openDlg($("#dlgQr")));

        /* boot: measure, lay out the world, put the camera on the cover */
        gsap.set(segs, { autoAlpha: .45 });
        fit(); layout(); place(); mark(0);

