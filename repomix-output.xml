    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
    <script>
        gsap.registerPlugin(SplitText);
        gsap.config({ force3D: true }); // transform/opacity only, always GPU layers

        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const k = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 1; // 0 = no motion
        const AUTO_SECONDS = 15;

        {{> guest.js}}

        /* fit the 414px design canvas to the screen */
        const stage = $("#stage");
        function fit() {
            const s = Math.min(innerWidth / 414, innerHeight / 736);
            gsap.set(stage, { scale: s, height: innerHeight / s, transformOrigin: "50% 0" });
        }
        fit();
        addEventListener("resize", fit);

        /* slides + nav state */
        const slides = $$(".slide"), idx = id => slides.findIndex(e => e.dataset.id === id);
        /* headline letters rise one by one; split only after the real fonts load, or SplitText measures fallback glyphs and the splits drift when the webfont swaps in */
        document.fonts.ready.then(() => SplitText.create(".slide h2, .slide h1 span", { type: "words,chars", charsClass: "ch" }));
        const items = $$("[data-go]");
        const shield = $("#mapShield");
        let cur = 0, opened = false, locked = false;

        gsap.set(slides.slice(1), { autoAlpha: 0 });
        gsap.set($$("[data-in]"), { autoAlpha: 0 });
        gsap.set("#tools", { yPercent: -130 });
        gsap.set("#actions", { y: 90 });
        gsap.set("#prog", { autoAlpha: 0 });
        gsap.set("[data-f]", { transformOrigin: (i, t) => ({ tl: "0% 0%", tr: "100% 0%", bl: "0% 100%", br: "100% 100%" })[t.dataset.f] });
        const mark = n => items.forEach(b => b.setAttribute("aria-current", +b.dataset.go === n));
        /* nav: list translates so the active item sits mid-view (clamped at both ends), pill slides to it */
        const navView = $("#navView"), navList = $("#navList"), pill = $("#pill");
        let m; // measured once at open (item widths are fixed): navTo then does no layout reads between tween writes
        const measure = () => m = { view: navView.clientWidth, w: navList.scrollWidth, itemW: items[0].parentElement.offsetWidth, lefts: items.map(b => b.parentElement.offsetLeft) };
        function navTo(n) {
            m ||= measure();
            gsap.to(pill, { x: m.lefts[n], duration: .5 * k, ease: "power3.out" });
            gsap.fromTo(pill, { scaleX: 1.3 }, { scaleX: 1, duration: .4 * k, ease: "power2.out" });
            gsap.fromTo(items[n].firstElementChild, { scale: .6, y: 5 }, { scale: 1, y: 0, duration: .5 * k, ease: "back.out(1.7)" });
            gsap.to(navList, { x: gsap.utils.clamp(m.view - m.w, 0, m.view / 2 - m.itemW / 2 - m.lefts[n]), duration: .5 * k, ease: "power3.out" });
        }
        const mapFrame = $("iframe[data-src]");
        const loadMap = () => { if (mapFrame.dataset.src) { mapFrame.src = mapFrame.dataset.src; mapFrame.removeAttribute("data-src"); } };
        /* corner frames part outward and settle back on every section change; one timeline, killed and restarted from wherever it is, so no snap */
        const OUT = { tl: [-1, -1], tr: [1, -1], bl: [-1, 1], br: [1, 1] };
        let kickTl;
        function kick() {
            if (!k) return;
            kickTl?.kill();
            kickTl = gsap.timeline()
                .to("[data-f]", { x: (i, t) => OUT[t.dataset.f][0] * 16, y: (i, t) => OUT[t.dataset.f][1] * 16, scale: 1.05, duration: .35, ease: "power2.out", overwrite: "auto" })
                .to("[data-f]", { x: 0, y: 0, scale: 1, duration: 1.1, ease: "expo.out" });
        }
        mark(0);

        function enter(slide) {
            const els = $$("[data-in]", slide);
            gsap.fromTo(els,
                { autoAlpha: 0, y: (i, t) => t.dataset.in === "down" ? -24 : t.dataset.in === "up" ? 24 : 0, scale: (i, t) => t.dataset.in === "zoom" ? .85 : 1 },
                { autoAlpha: 1, y: 0, scale: 1, duration: 1.1 * k, ease: "expo.out", stagger: .1 * k, overwrite: true });
            const ch = $$(".ch", slide);
            if (ch.length) gsap.fromTo(ch, { autoAlpha: 0, yPercent: 70 }, { autoAlpha: 1, yPercent: 0, duration: .9 * k, ease: "expo.out", stagger: .035 * k, delay: .25 * k, overwrite: true });
        }

        /* progress segments: before the current = full, after = empty, current fills (autoplay) or snaps full */
        const bars = $$("#prog b");
        gsap.set(bars, { scaleX: 0 });
        function paintBars(n) {
            bars.forEach((b, i) => gsap.set(b, { scaleX: i < n ? 1 : 0 }));
            if (autoOn) runAuto(); else gsap.to(bars[n], { scaleX: 1, duration: .4 * k });
        }

        function go(n, pause = true) {
            n = gsap.utils.clamp(0, slides.length - 1, n);
            if (pause) stopAuto();
            if (n === cur) return;
            const dir = n > cur || (cur === slides.length - 1 && n === 0) ? 1 : -1; // wrap counts as forward
            const out = slides[cur], inn = slides[n];
            cur = n;
            // slides travel with the swipe: old one leaves up, new one rises in from below
            gsap.to(out, { autoAlpha: 0, y: -48 * dir, duration: .4 * k, ease: "power2.out", overwrite: true });
            gsap.fromTo(inn, { y: 48 * dir }, { autoAlpha: 1, y: 0, duration: .8 * k, delay: .2 * k, ease: "expo.out", overwrite: true });
            enter(inn);
            mark(n);
            navTo(n);
            paintBars(n);
            shield.hidden = false; // map ignores swipes again after leaving its slide
            kick();
            if (n >= idx("event")) loadMap();
        }
        items.forEach(b => b.addEventListener("click", () => opened && go(+b.dataset.go)));
        shield.addEventListener("click", () => shield.hidden = true);

        /* autoplay: one progress tween per slide; finishing it moves to the next slide. seconds per slide, tune here */
        const DUR = slides.map(e => +e.dataset.dur);
        let autoOn = false, autoTw;
        function runAuto() {
            autoTw?.kill();
            gsap.set(bars[cur], { scaleX: 0 });
            autoTw = gsap.to(bars[cur], { scaleX: 1, duration: DUR[cur], ease: "none", onComplete: () => go(gsap.utils.wrap(0, slides.length, cur + 1), false) });
        }
        const btnAuto = $("#btnAuto");
        const setAutoIcon = on => {
            btnAuto.firstElementChild.className = "ph-fill text-xl " + (on ? "ph-pause-circle" : "ph-play-circle");
            btnAuto.setAttribute("aria-pressed", on);
        };
        function startAuto() { autoOn = true; runAuto(); setAutoIcon(true); }
        function stopAuto() { autoOn = false; autoTw?.kill(); gsap.set(bars[cur], { scaleX: 1 }); setAutoIcon(false); }
        btnAuto.addEventListener("click", () => autoOn ? stopAuto() : (opened ? startAuto() : openInvitation()));

        /* swipe / wheel / drag: native events only. up or wheel-down = next */
        let swipeOn = false, y0 = null;
        const swipe = d => {
            if (locked) return;
            locked = true;
            gsap.delayedCall(.7, () => locked = false);
            go(d > 0 ? gsap.utils.wrap(0, slides.length, cur + 1) : cur - 1); // next wraps to start, prev stops at 0
        };
        const dist = () => 50 * (stage.getBoundingClientRect().width / 414); // 50 design px, in screen px
        stage.addEventListener("pointerdown", e => { y0 = swipeOn ? e.clientY : null; });
        stage.addEventListener("pointerup", e => {
            if (y0 === null) return;
            const d = y0 - e.clientY;
            y0 = null;
            if (Math.abs(d) > dist()) swipe(d);
        });
        stage.addEventListener("pointercancel", () => y0 = null);
        stage.addEventListener("wheel", e => { if (swipeOn && Math.abs(e.deltaY) > 20) swipe(e.deltaY); }, { passive: true });
        addEventListener("keydown", e => {
            if ($("#dlgLb").open) {
                if (e.key === "ArrowLeft") showShot(lb - 1);
                if (e.key === "ArrowRight") showShot(lb + 1);
                return;
            }
            if (!opened || document.querySelector("dialog[open]") || e.target.matches?.("input,textarea,select")) return;
            if (e.key === "ArrowDown" || e.key === "ArrowRight") swipe(1);
            if (e.key === "ArrowUp" || e.key === "ArrowLeft") swipe(-1);
        });

        {{> music.js}}

        /* open invitation */
        function openInvitation() {
            if (opened) return;
            opened = true;
            measure(); // read layout before any tween writes this frame
            $("#btnOpen").hidden = true;
            playMusic();
            $("#tools").inert = $("#actions").inert = false;
            gsap.timeline({ defaults: { duration: .8 * k, ease: "power3.out", overwrite: "auto" } })
                .to("#tools", { yPercent: 0 })
                .to("#actions", { y: 0 }, "<")
                .to("#prog", { autoAlpha: 1 }, "<");
            swipeOn = true;
            startAuto();
            go(1, false);
        }
        $("#btnOpen").addEventListener("click", openInvitation);

        /* corner frames: the one authored moment on load */
        const intro = () => {
            gsap.from('[data-f="tl"]', { x: -60, y: -60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="tr"]', { x: 60, y: -60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="bl"]', { x: -60, y: 60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            gsap.from('[data-f="br"]', { x: 60, y: 60, autoAlpha: 0, duration: 1.4 * k, ease: "expo.out" });
            enter(slides[0]);
        };

        /* loader */
        let ready = false;
        const hideLoader = () => {
            if (ready) return;
            ready = true;
            gsap.to("#loader", { autoAlpha: 0, duration: .4 * k, onComplete: intro });
        };
        addEventListener("load", () => setTimeout(hideLoader, 100));
        setTimeout(hideLoader, 5000);

        /* dialogs: native <dialog>, pause autoplay + swipe while open, backdrop click closes */
        let resumeAuto = false;
        function openDlg(d) {
            resumeAuto = autoOn;
            stopAuto(); swipeOn = false;
            d.showModal();
            gsap.fromTo(d, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .35 * k, ease: "power3.out" });
        }
        $$("dialog").forEach(d => {
            d.addEventListener("close", () => {
                if (opened) swipeOn = true;
                if (resumeAuto) startAuto();
            });
            d.addEventListener("click", e => { if (e.target === d) d.close(); });
        });
        $("#btnQr").addEventListener("click", () => openDlg($("#dlgQr")));
        $("#btnLoc").addEventListener("click", () => go(idx("map"))); // quick way back to the map section

