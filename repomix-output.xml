    <link rel="icon"
        href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23573E28'/%3E%3Ctext x='16' y='23' font-size='21' text-anchor='middle' fill='%23D1A046' font-family='serif' font-style='italic'%3E%26%3C/text%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Outfit:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.0.3/src/fill/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @theme {
            --color-cream: #F3E1CF;
            --color-paper: #FBF4EA;
            --color-ink: #573E28;
            --color-muted: #6B5440;    /* 5.5:1 on cream; replaces ink/60 (3.4:1) */
            --color-gold: #D1A046;
            --color-gold-ink: #7D5A10; /* gold for text: 4.9:1 on cream */
            --color-seal: #9A2B1E;     /* Chinese red, used sparingly: ampersands */
            --font-sans: "Outfit", sans-serif;
            --font-display: "Cormorant Garamond", serif;
        }
        /* z scale: grain 0 · frames 1 · slides 10 · tools 20 · loader 50 */
        @layer base {
            html, body { height: 100%; overflow: hidden; background: var(--color-cream); }
            body { font-family: var(--font-sans); color: var(--color-ink); -webkit-tap-highlight-color: transparent; }
            h1, h2, h3, blockquote { text-wrap: balance; }
            p { text-wrap: pretty; }
            ::selection { background: color-mix(in srgb, var(--color-gold) 45%, transparent); }
            :focus-visible { outline: 2px solid #7D5A10; outline-offset: 2px; }
            dialog::backdrop { background: rgb(40 26 14 / .6); }
            button { cursor: pointer; }
            #stage { touch-action: none; }
            [data-scroll] { touch-action: pan-y; }
            .field:user-invalid { border-color: #a3402a; }
        }
        @utility btn { @apply inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-ink px-6 text-sm font-medium text-paper shadow-[0_10px_24px_-10px_rgb(87_62_40/.55)] transition duration-200 hover:-translate-y-0.5 hover:bg-[#6a4c31] active:translate-y-0 active:scale-[.97] disabled:opacity-60; }
        @utility btn-ghost { @apply inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-ink/30 px-5 text-sm font-medium text-ink transition duration-200 hover:bg-ink/5 active:scale-[.97]; }
        @utility tlink { @apply inline-flex min-h-8 items-center gap-1.5 text-sm font-medium text-gold-ink underline decoration-gold/60 underline-offset-4 transition-colors hover:text-ink; }
        @utility field { @apply w-full rounded-xl border border-ink/25 bg-white px-3.5 py-2.5 text-sm text-ink transition-colors focus:border-gold-ink disabled:bg-ink/5 disabled:text-muted; }
        @utility grain { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .34 0 0 0 0 .24 0 0 0 0 .16 0 0 0 .9 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }

        /* solid floating surface: readable over the patterned background */
        @utility float { @apply bg-paper ring-1 ring-ink/25 shadow-[0_8px_24px_-8px_rgb(87_62_40/.5)]; }
        @utility nav-chip { @apply relative z-10 flex h-14 w-full flex-col items-center justify-center gap-0.5 text-xs font-medium text-muted transition-colors duration-300 aria-[current=true]:text-paper; }
        @utility act-btn { @apply grid size-12 place-items-center rounded-full bg-ink/10 text-ink transition duration-200 hover:bg-ink/15 active:scale-95 aria-pressed:bg-ink aria-pressed:text-paper; }
    </style>
</head>

<body>
    <!-- loader -->
    <div id="loader" class="fixed inset-0 z-50 grid place-items-center bg-cream" style="background:#F3E1CF">
        <div class="text-center">
            <p class="animate-pulse font-display text-4xl italic text-ink">Bima &amp; Laras</p>
            <span class="mx-auto mt-4 block h-px w-24 bg-gold"></span>
        </div>
    </div>

    <audio id="music" loop preload="none" src="assets/music.wav"></audio>


    <!-- viewport: stage is a fixed 414px design canvas, scaled to fit by JS. inside: depth layers (bg, far, mid, frames) + the world (route + stations) -->
    <div id="viewport" class="fixed inset-0 flex justify-center overflow-hidden">
        <main id="stage" class="relative w-[414px] shrink-0 origin-top overflow-hidden bg-cream" style="height:736px">
            <div id="bg" aria-hidden="true"
                class="absolute -inset-[8%] bg-cover bg-center bg-no-repeat will-change-transform"
                style="background-image:url(assets/bg.svg)"></div>
            <div aria-hidden="true" class="grain pointer-events-none absolute inset-0 z-0 opacity-[.07]"></div>
            <div id="far" aria-hidden="true"
                class="pointer-events-none absolute left-0 top-0 z-[1] will-change-transform"></div>
            <div id="mid" aria-hidden="true"
                class="pointer-events-none absolute left-0 top-0 z-[2] will-change-transform"></div>
            <div id="frames" class="pointer-events-none absolute inset-0 z-[3]">
                <img data-f="tl" src="assets/frame-tl.svg" alt=""
                    class="will-change-transform absolute left-0 top-0 w-1/2">
                <img data-f="tr" src="assets/frame-tr.svg" alt=""
                    class="will-change-transform absolute right-0 top-0 w-1/2">
                <img data-f="bl" src="assets/frame-bl.svg" alt=""
                    class="will-change-transform absolute bottom-0 left-0 w-1/2">
                <img data-f="br" src="assets/frame-br.svg" alt=""
                    class="will-change-transform absolute bottom-0 right-0 w-1/2">
            </div>

            <!-- world: every section is a station on a winding path; the camera flies between them -->
            <div id="world" class="absolute left-0 top-0 z-10 will-change-transform">
                <svg id="route" aria-hidden="true" class="pointer-events-none absolute left-0 top-0 overflow-visible"
                    width="1" height="1" fill="none" stroke="#D1A046" stroke-width="6" stroke-linecap="round"
                    stroke-dasharray="1 16"></svg>
                <div class="panel group absolute left-0 top-0 w-[414px]" data-i="0" style="height:var(--H)">
                    <div class="ov pointer-events-none absolute inset-0" aria-hidden="true">
                        <div
                            class="absolute inset-0 rounded-[44px] bg-paper/55 ring-4 ring-gold/60 group-data-[cur]:bg-paper/85 group-data-[cur]:ring-seal">
                        </div>
                        <div class="absolute inset-0 grid place-items-center px-8">
                            <p
                                class="text-center font-display text-[60px] font-semibold italic leading-[.95] text-gold-ink group-data-[cur]:text-seal">
                            </p>
                        </div>
                    </div>
                    <section
                        class="pc absolute inset-0 flex flex-col items-center justify-center px-[34px] py-[72px] text-center"
                        aria-label="Sampul">
                        <img data-in="zoom"
                            src="assets/logo.svg"
                            alt="Logo pernikahan" class="mb-3 h-[140px] w-full object-contain">
                        <div data-in="down" class="w-full">
                            <p class="font-display text-lg italic text-muted">Undangan pernikahan</p>
                            <h1
                                class="my-3 flex w-full flex-col font-display text-[64px] font-semibold italic leading-[.9] tracking-tight text-ink">
                                <span class="self-start">Bima</span>
                                <span class="self-center text-[36px] font-medium text-seal">&amp;</span>
                                <span class="self-end">Laras</span>
                            </h1>
                            <p class="text-sm font-medium tabular-nums">Sabtu, 21 Februari 2027</p>
                        </div>
                        <div data-in="up" class="mt-6 max-w-[300px]">
                            <p class="text-sm text-muted">Kepada Yth.<br>Bapak/Ibu/Saudara/i</p>
                            <p data-guest class="mb-5 mt-1 font-display text-[28px] font-semibold leading-tight">Nama
                                Tamu
                            </p>
                            <button id="btnOpen" class="btn">Buka undangan</button>
                        </div>
                    </section>
                </div>
                <div class="panel group absolute left-0 top-0 w-[414px]" data-i="1" style="height:var(--H)">
                    <div class="ov pointer-events-none absolute inset-0" aria-hidden="true">
                        <div
                            class="absolute inset-0 rounded-[44px] bg-paper/55 ring-4 ring-gold/60 group-data-[cur]:bg-paper/85 group-data-[cur]:ring-seal">
                        </div>
                        <div class="absolute inset-0 grid place-items-center px-8">
                            <p
                                class="text-center font-display text-[60px] font-semibold italic leading-[.95] text-gold-ink group-data-[cur]:text-seal">
                            </p>
                        </div>
                    </div>
                    <section
                        class="pc absolute inset-0 flex flex-col items-start justify-center px-[40px] py-[72px] text-left"
                        aria-label="Ayat">
                        <span data-in="down" aria-hidden="true"
                            class="font-display text-[96px] leading-[.6] text-gold">&ldquo;</span>
                        <blockquote data-in="up">
                            <p class="font-display text-[30px] italic leading-snug">Dan segala sesuatu Kami ciptakan
                                berpasang-pasangan agar kamu mengingat (kebesaran Allah).</p>
                            <footer class="mt-5 text-sm text-muted">Q.S. Ar-Rum ayat 21</footer>
                        </blockquote>
                    </section>
                </div>
                <div class="panel group absolute left-0 top-0 w-[414px]" data-i="2" style="height:var(--H)">
                    <div class="ov pointer-events-none absolute inset-0" aria-hidden="true">
                        <div
                            class="absolute inset-0 rounded-[44px] bg-paper/55 ring-4 ring-gold/60 group-data-[cur]:bg-paper/85 group-data-[cur]:ring-seal">
                        </div>
                        <div class="absolute inset-0 grid place-items-center px-8">
                            <p
                                class="text-center font-display text-[60px] font-semibold italic leading-[.95] text-gold-ink group-data-[cur]:text-seal">
                            </p>
                        </div>
                    </div>
                    <section
                        class="pc absolute inset-0 flex flex-col items-start justify-center px-[34px] py-[72px] text-left"
                        aria-label="Mempelai">
                        <p data-in="down" class="mb-6 text-sm text-muted">Tanpa mengurangi rasa hormat, kami bermaksud
                            mengundang Bapak/Ibu/Saudara/i pada acara resepsi pernikahan kami:</p>
                        <div data-in="up" class="mb-2">
                            <h2 class="mb-2 font-display text-[40px] font-semibold italic leading-none text-gold-ink">
                                Akhmad
                                Bima</h2>
                            <p class="mb-2 text-sm">Putra kedua Bapak Suryanto<br>dan Ibu Sri Wahyuni</p>
                            <a href="https://instagram.com/akhmadfaisal" target="_blank" rel="noreferrer noopener"
                                class="tlink"><i class="ph-fill ph-instagram-logo text-lg"></i>@bima.prasetya</a>
                        </div>
                        <span data-in="up" aria-hidden="true"
                            class="self-center font-display text-[44px] italic leading-none text-seal">&amp;</span>
                        <div data-in="up" class="mt-2 self-end text-right">
                            <h2 class="mb-2 font-display text-[40px] font-semibold italic leading-none text-gold-ink">
                                Laras
                                Hidayati</h2>
                            <p class="mb-2 text-sm">Putri pertama Bapak Hendra Wijaya<br>dan Ibu Ratna Dewi</p>
                            <a href="https://instagram.com/noor_hidayati" target="_blank" rel="noreferrer noopener"
                                class="tlink"><i class="ph-fill ph-instagram-logo text-lg"></i>@larasati.w</a>
                        </div>
                    </section>
                </div>
                <div class="panel group absolute left-0 top-0 w-[414px]" data-i="3" style="height:var(--H)">
                    <div class="ov pointer-events-none absolute inset-0" aria-hidden="true">
